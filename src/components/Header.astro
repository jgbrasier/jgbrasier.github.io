---
const path = Astro.url.pathname;
const nav = [
  { href: '/cv/', label: 'Work' },
  { href: '/talks/', label: 'Appearances' },
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Jean-Guillaume Brasier, home">
      <span>JG</span><span class="wordmark-dot">.</span>
    </a>
    <nav aria-label="Main navigation">
      {nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
