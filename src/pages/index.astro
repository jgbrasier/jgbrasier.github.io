---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppearanceCard from '../components/AppearanceCard.astro';
import { appearances, experience, profile } from '../data/site';
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="kicker">Data scientist · Boston</p>
      <h1>Probabilistic models. <span>Graphs. LLMs.</span></h1>
      <p class="hero-intro">
        I use them to solve complex business problems in high-entropy systems.
      </p>
      <p class="hero-now">
        Currently a Senior Data Scientist at Vertex Pharmaceuticals. Moderna and Harvard Medical School alum. I hold an
        <a href="https://seas.harvard.edu/masters-data-science">M.S. in Data Science from Harvard</a> and an
        <a href="https://www.espci.psl.eu/en/education/espci-engineering-program/">M.Eng. from ESPCI Paris</a>.
      </p>
      <figure class="hero-quote">
        <blockquote>“You just can’t beat the person who never gives up.”</blockquote>
        <figcaption>— Babe Ruth</figcaption>
      </figure>
      <div class="hero-actions">
        <a class="button" href="/cv/">What I’ve worked on</a>
        <a class="text-link" href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={profile.medium}>Medium <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="portrait-wrap" aria-label="Portrait of Jean-Guillaume Brasier">
      <div class="portrait-frame">
        <img src="/profile.jpg" alt="Jean-Guillaume Brasier" width="680" height="645" />
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="selected-work">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2 id="selected-work">A few things that escaped the notebook.</h2>
    </div>
    <div class="work-grid">
      {experience.slice(0, 3).map((item, index) => (
        <article class={`work-card tone-${index + 1}`}>
          <div class="work-card-meta">
            <span>{item.company}</span>
            <span>{item.dates}</span>
          </div>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
    <a class="text-link section-link" href="/cv/">The full timeline <span aria-hidden="true">→</span></a>
  </section>

  <section class="section shell" aria-labelledby="recent-appearances">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Recently, with a microphone</p>
        <h2 id="recent-appearances">Talks & conversations.</h2>
      </div>
      <a class="text-link" href="/talks/">See all <span aria-hidden="true">→</span></a>
    </div>
    <div class="appearance-grid">
      {appearances.slice(0, 2).map((item) => <AppearanceCard item={item} />)}
    </div>
  </section>

  <section class="shell off-duty">
    <p class="eyebrow">Off duty</p>
    <p class="off-duty-copy">
      Elite sponsored triathlete, multiple Ironman podiums, World Championship qualifier, and former national-level rugby player. Apparently one demanding hobby was not enough.
    </p>
  </section>
</BaseLayout>
