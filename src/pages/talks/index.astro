---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppearanceCard from '../../components/AppearanceCard.astro';
import { appearances } from '../../data/site';
---

<BaseLayout title="Appearances" description="Talks, seminars, and podcast appearances by Jean-Guillaume Brasier.">
  <header class="page-hero shell">
    <h1>Appearances</h1>
    <p>Talks, seminars, and podcasts.</p>
  </header>
  <section class="shell appearance-grid appearance-grid-page" aria-label="Talks and podcasts">
    {appearances.map((item) => <AppearanceCard item={item} />)}
  </section>
</BaseLayout>
